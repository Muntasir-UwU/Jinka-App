# Release keystore configuration - COPY THIS TO keystore.properties AND FILL IN
# NEVER commit keystore.properties or the .jks file to version control!

# Path to the keystore file (relative to project root or absolute path)
storeFile=../release.keystore

# Keystore password
storePassword=your_keystore_password

# Key alias
keyAlias=jinki-release

# Key password (can be same as keystore password)
keyPassword=your_key_password
