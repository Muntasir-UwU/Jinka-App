{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)"
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "playback": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('syncGrants').child($uid).child(auth.uid).child('expiresAt').val() > now)",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "syncGrants": {
      "$target": {
        "$viewer": {
          ".read": "auth != null && (auth.uid === $target || auth.uid === $viewer)",
          ".write": false
        }
      }
    },
    "private": {
      ".read": false,
      ".write": false
    }
  }
}
