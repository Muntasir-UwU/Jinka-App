<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is forbidden everywhere (the manifest also sets
  usesCleartextTraffic="false"), with system trust anchors only. There is
  deliberately no per-domain section: the previous one listed wildcard
  entries (`*.cdn.cloudflare.net`, `*.fastly.net`) that are not valid
  <domain> values, and every host the app talks to serves HTTPS anyway.
  If a cleartext host is ever needed, add a domain-config with a real
  hostname and includeSubdomains="true" — never a leading "*." entry.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
